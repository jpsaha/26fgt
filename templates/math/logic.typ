//==============================================================
// logic.typ
//
// Logic
// Relations
// Quantifiers
// Arrows
//
//==============================================================



//==============================================================
// Quantifiers
//==============================================================

#let forall = $forall$
#let exists = $exists$
#let nexists = $exists.not$



//==============================================================
// Logical Connectives
//==============================================================

#let land = $and$
#let lor = $or$

#let implies = $=>$
#let impliedby = $<=$
#let iff = $<=>$

#let limplies = $==>$
#let liff = $<==>$

#let neg = $not$



//==============================================================
// Set Relations
//==============================================================

#let in = $in$
#let nin = $in.not$

#let subset = $subset$
#let subseteq = $subset.eq$

#let supset = $supset$
#let supseteq = $supset.eq$

#let union = $union$
#let inter = $sect$

#let empty = $emptyset$



//==============================================================
// Equality
//==============================================================

#let neq = $!=$
#let equiv = $equiv$

#let approx = $approx$
#let cong = $cong$

#let sim = $sim$
#let simeq = $simeq$



//==============================================================
// Order
//==============================================================

#let le = $<=$
#let ge = $>=$

#let lt = $<$
#let gt = $>$



//==============================================================
// Arrows
//==============================================================

#let to = $->$

#let from = $<-$

#let mapsto = $|->$

#let longto = $-->$

#let longmapsto = $|-->$

#let iso = $tilde.arrow(r)$



//==============================================================
// Miscellaneous
//==============================================================

#let therefore = $therefore$
#let because = $because$

#let perp = $perp$
#let parallel = $parallel$

#let angle = $angle$
#let measuredangle = $angle.arc$

#let proportional = $prop$