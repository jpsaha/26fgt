# ============================================================
# Build output
# ============================================================

# Generated/publication output
dist/*

# ------------------------------------------------------------
# Locally generated Open Graph PNGs
#
# Keep all dist/ output ignored except:
#
#     dist/assets/og/**/*.png
#
# These PNGs are generated locally and committed so that
# GitHub deployment does not need LaTeX, Asymptote, or
# ImageMagick.
# ------------------------------------------------------------

!dist/assets/
dist/assets/*

!dist/assets/og/
dist/assets/og/*

# Allow OG subdirectories
!dist/assets/og/**/

# Allow generated OG PNG files
!dist/assets/og/**/*.png

# Build diagnostics
diagnostics/*

# Machine-generated intermediate files
generated/*

# !scripts/lint/generated

# ============================================================
# Python
# ============================================================

__pycache__/
*.py[cod]


# ============================================================
# Python virtual environments
# ============================================================

.venv/
venv/
env/


# ============================================================
# OS / editor files
# ============================================================

.DS_Store
.vscode/
.idea/



# ============================================================
# Assets
# ============================================================

assets/og/default.pdf

pdflayout_old.typ

templates/euler/

content/mopss


coding/